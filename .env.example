# causeway — 호스트 로컬 설정. 이 파일을 `.env` 로 복사해 채운다(`.env` 는 gitignore 대상).
#
# 원칙: **자격증명은 봇 프로세스에만 둔다.** 세션(spawn 된 Claude Code)의 env 는
# `src/runner/profiles.ts` 의 `SENSITIVE_ENV_PATTERNS` 로 스크럽되므로, 세션은 여기 값을 볼 수
# 없다. 외부 API 를 부르는 도구는 in-process MCP 로 감싸서 **결과 요약만** 세션에 넘긴다.

# ─────────────────────────────────────────────────────────────────────────────
# 필수 — Slack
# ─────────────────────────────────────────────────────────────────────────────
# api.slack.com/apps → 앱 생성(config/slack-app-manifest.yaml 붙여넣기) 후:
#   OAuth & Permissions → Bot User OAuth Token (xoxb-…)
SLACK_BOT_TOKEN=
#   Basic Information → App-Level Tokens → connections:write 스코프로 생성 (xapp-…)
SLACK_APP_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 필수 — Claude 인증 (둘 중 하나)
# ─────────────────────────────────────────────────────────────────────────────
# 권장: 장수명 토큰. `claude setup-token` 으로 발급한다.
#   ⚠️ 이 명령은 **로그인된 상태를 전제한다.** 만료 상태면 브라우저 승인을 해도 토큰이 안 나온다.
#      `claude auth status --text` 로 먼저 확인하고, Expired 면 `claude auth login` 부터.
#   ⚠️ 사람의 인터랙티브 로그인에 얹지 마라 — 그게 만료되는 날 봇이 죽는데, 슬랙에는
#      `OAuth session expired` 로만 보여서 원인을 찾기 어렵다.
CLAUDE_CODE_OAUTH_TOKEN=
# 또는 API 키 직접 사용
# ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 선택 — 경로·동작
# ─────────────────────────────────────────────────────────────────────────────
# 세션의 기본 작업 디렉토리(레포 루트 기준 상대경로 또는 절대경로). 기본 `workspace`.
# CAUSEWAY_WORKSPACE_DIR=workspace
# 세션이 읽을 수 있는 추가 경로(콤마 구분). 존재하지 않는 경로는 선언에서 빠진다 —
# 없는 디렉토리를 선언하면 "읽을 수 있다"는 오해만 남기 때문이다.
# CAUSEWAY_REFERENCE_DIRS=/path/to/repo-a,/path/to/repo-b
# SQLite 경로(잡 큐·세션 매핑). 기본 `var/causeway.db`.
# CAUSEWAY_DB_PATH=var/causeway.db
# config 디렉토리. 기본 `config`.
# CAUSEWAY_CONFIG_DIR=config
# 부팅 정상성 판정 타임아웃(초). 기본 60.
# CAUSEWAY_BOOT_TIMEOUT=60
# 절전/슬립 감지기(맥에서 소켓 좀비화 복구용). 기본 on.
# CAUSEWAY_WAKE_DETECTOR=on

# ─────────────────────────────────────────────────────────────────────────────
# 선택 — 자동 업데이터 (scripts/auto-update.sh)
# ─────────────────────────────────────────────────────────────────────────────
# CAUSEWAY_UPDATE_BRANCH=main
# CAUSEWAY_UPDATE_INTERVAL=300        # 폴링 주기(초)
# CAUSEWAY_UPDATE_REQUIRE_CI=1        # 1이면 해당 커밋 CI 성공일 때만 배포

# ─────────────────────────────────────────────────────────────────────────────
# 선택 — 매니페스트 자동 반영 (scripts/push-manifest.mjs)
# ─────────────────────────────────────────────────────────────────────────────
# api.slack.com/apps → 우측 "Your App Configuration Tokens" → Generate Token
# 나온 **Refresh Token(xoxe-1-…)** 만 넣으면 된다. access 토큰은 12시간 만료라 스크립트가
# 스스로 회전하고 이 파일에 되쓴다(회전된 refresh 를 잃으면 콘솔에서 재발급해야 한다).
# SLACK_CONFIG_REFRESH_TOKEN=
